// Schema Prisma - Controle de Manutenção de Frotas (P2)
// Banco de Dados: SQLite

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. Modelo de Plano de Manutenção Preventiva
model PlanoManutencao {
  id             Int       @id @default(autoincrement())
  nome           String
  descricao      String?
  intervaloKm    Int       @map("intervalo_km")
  intervaloMeses Int       @map("intervalo_meses")
  itensChecagem  String?   @map("itens_checagem") // Itens serializados em formato texto/JSON
  criadoEm       DateTime  @default(now()) @map("criado_em")

  // Relacionamento 1:N com Veículos
  veiculos       Veiculo[]

  @@map("planos_manutencao")
}

// 2. Modelo de Veículo da Frota
model Veiculo {
  id                   Int              @id @default(autoincrement())
  placa                String           @unique
  marca                String
  modelo               String
  ano                  Int
  kmAtual              Int              @map("km_atual")
  kmProximaRevisao     Int?             @map("km_proxima_revisao")
  dataProximaRevisao   DateTime?        @map("data_proxima_revisao")
  status               String           @default("EM_OPERACAO") // EM_OPERACAO, EM_MANUTENCAO, INATIVO
  categoria            String           @default("Geral")
  capacidadeCargaKg    Float?           @map("capacidade_carga_kg")
  motoristaResponsavel String?          @map("motorista_responsavel")
  criadoEm             DateTime         @default(now()) @map("criado_em")
  atualizadoEm         DateTime         @updatedAt @map("atualizado_em")

  // Chave estrangeira e relacionamento com Plano de Manutenção
  planoManutencaoId    Int?             @map("plano_manutencao_id")
  planoManutencao      PlanoManutencao? @relation(fields: [planoManutencaoId], references: [id], onDelete: SetNull)

  // Relacionamento 1:N com Ordens de Serviço
  ordensServico        OrdemServico[]

  @@map("veiculos")
}

// 3. Modelo de Ordem de Serviço (O.S.)
model OrdemServico {
  id                  Int       @id @default(autoincrement())
  codigoOS            String    @unique @map("codigo_os")
  tipo                String    @default("PREVENTIVA") // PREVENTIVA ou CORRETIVA
  status              String    @default("ABERTA")     // ABERTA, EM_ANDAMENTO, CONCLUIDA, CANCELADA
  mecanicoResponsavel String    @map("mecanico_responsavel")
  kmNoMomento         Int       @map("km_no_momento")
  dataAbertura        DateTime  @default(now()) @map("data_abertura")
  dataPrevisao        DateTime? @map("data_previsao")
  dataConclusao       DateTime? @map("data_conclusao")
  descricao           String
  pecasJson           String?   @map("pecas_json")       // Lista de peças em JSON string
  maoDeObraJson       String?   @map("mao_de_obra_json") // Detalhes de mão de obra em JSON string
  valorTotalPecas     Float     @default(0) @map("valor_total_pecas")
  valorTotalMaoDeObra Float     @default(0) @map("valor_total_mao_de_obra")
  valorTotalGeral     Float     @default(0) @map("valor_total_geral")
  observacoes         String?
  criadoEm            DateTime  @default(now()) @map("criado_em")
  atualizadoEm        DateTime  @updatedAt @map("atualizado_em")

  // Chave estrangeira e relacionamento com Veículo
  veiculoId           Int       @map("veiculo_id")
  veiculo             Veiculo   @relation(fields: [veiculoId], references: [id], onDelete: Restrict)

  @@map("ordens_servico")
}

// 4. Modelo de Mecânico e Especialista da Oficina
model Mecanico {
  id            Int      @id @default(autoincrement())
  nome          String
  cargo         String
  especialidade String
  telefone      String?
  status        String   @default("DISPONIVEL") // DISPONIVEL, OCUPADO, AFASTADO
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  @@map("mecanicos")
}
